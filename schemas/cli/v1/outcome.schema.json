{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DiagnosticContext": {
      "additionalProperties": true,
      "properties": {
        "path": {
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "DiagnosticEntry": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/DiagnosticContext"
        },
        "message": {
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "EvidenceRecorded": {
      "additionalProperties": false,
      "properties": {
        "inline": {
          "type": "boolean"
        },
        "provider": {
          "type": "boolean"
        },
        "selected_associations": {
          "type": "boolean"
        }
      },
      "required": [
        "inline",
        "selected_associations",
        "provider"
      ],
      "type": "object"
    },
    "ExportResult": {
      "additionalProperties": false,
      "properties": {
        "journal_file": {
          "const": "journal.jsonl",
          "type": "string"
        },
        "manifest_file": {
          "const": "manifest.json",
          "type": "string"
        },
        "output": {
          "minLength": 1,
          "type": "string"
        },
        "state_file": {
          "const": "state.json",
          "type": "string"
        }
      },
      "required": [
        "output",
        "manifest_file",
        "state_file",
        "journal_file"
      ],
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "actor.invalid",
        "catalog.ack_token.invalid",
        "catalog.ack_token.stale",
        "catalog.active_runs.changed",
        "catalog.config.invalid",
        "catalog.handle.duplicate",
        "catalog.handle.invalid",
        "catalog.handle.occupied",
        "catalog.registration.not_found",
        "compatibility.unsupported",
        "cursor.invalid",
        "event.unknown",
        "evidence.invalid",
        "evidence.selection.invalid",
        "export.target.invalid",
        "export.target.not_empty",
        "gate.failed",
        "guidance.unsupported",
        "input.invalid",
        "input.rejected",
        "label.invalid",
        "note.invalid",
        "persistence.failed",
        "provider.crash",
        "provider.drift.detected",
        "provider.evaluation_error",
        "provider.evidence.malformed",
        "provider.executable.not_found",
        "provider.graph.invalid",
        "provider.nonzero_exit",
        "provider.protocol.invalid_utf8",
        "provider.protocol.malformed",
        "provider.protocol.oversized",
        "provider.protocol.unsupported_major",
        "provider.registration.missing",
        "provider.registration.stale",
        "provider.signal",
        "provider.spawn.failed",
        "provider.timeout",
        "provider.tombstoned",
        "resource.exhausted",
        "run.lifecycle.denied",
        "run.lifecycle.terminal",
        "run.not_found",
        "state.stale_version"
      ],
      "type": "string"
    },
    "ReasonObject": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "RunSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "lifecycle": {
          "enum": [
            "active",
            "final",
            "terminated"
          ],
          "type": "string"
        },
        "state": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "state_changed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "lifecycle",
        "state",
        "state_changed"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "completed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "rejected"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "allOf": [
              {
                "$ref": "#/$defs/ReasonObject"
              },
              {
                "properties": {
                  "code": {
                    "enum": [
                      "actor.invalid",
                      "catalog.ack_token.invalid",
                      "catalog.ack_token.stale",
                      "catalog.active_runs.changed",
                      "catalog.config.invalid",
                      "catalog.handle.duplicate",
                      "catalog.handle.invalid",
                      "catalog.handle.occupied",
                      "catalog.registration.not_found",
                      "compatibility.unsupported",
                      "cursor.invalid",
                      "event.unknown",
                      "evidence.invalid",
                      "evidence.selection.invalid",
                      "export.target.invalid",
                      "export.target.not_empty",
                      "gate.failed",
                      "guidance.unsupported",
                      "input.invalid",
                      "input.rejected",
                      "label.invalid",
                      "note.invalid",
                      "run.lifecycle.denied",
                      "run.lifecycle.terminal",
                      "run.not_found"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "error"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "allOf": [
              {
                "$ref": "#/$defs/ReasonObject"
              },
              {
                "properties": {
                  "code": {
                    "enum": [
                      "persistence.failed",
                      "provider.crash",
                      "provider.drift.detected",
                      "provider.evaluation_error",
                      "provider.evidence.malformed",
                      "provider.executable.not_found",
                      "provider.graph.invalid",
                      "provider.nonzero_exit",
                      "provider.protocol.invalid_utf8",
                      "provider.protocol.malformed",
                      "provider.protocol.oversized",
                      "provider.protocol.unsupported_major",
                      "provider.registration.missing",
                      "provider.registration.stale",
                      "provider.signal",
                      "provider.spawn.failed",
                      "provider.timeout",
                      "provider.tombstoned",
                      "resource.exhausted",
                      "state.stale_version"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data": {
            "properties": {
              "run": {
                "properties": {
                  "lifecycle": {
                    "enum": [
                      "final",
                      "terminated"
                    ]
                  }
                },
                "required": [
                  "lifecycle"
                ],
                "type": "object"
              }
            },
            "required": [
              "run"
            ],
            "type": "object"
          }
        },
        "required": [
          "data"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "requestable_events": {
                "maxItems": 0,
                "type": "array"
              }
            },
            "required": [
              "requestable_events"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data": {
            "properties": {
              "run": {
                "properties": {
                  "lifecycle": {
                    "const": "active"
                  }
                },
                "required": [
                  "lifecycle"
                ],
                "type": "object"
              }
            },
            "required": [
              "run"
            ],
            "type": "object"
          }
        },
        "required": [
          "data"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "requestable_events": {
                "type": "array"
              }
            },
            "required": [
              "requestable_events"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data": {
            "not": {
              "required": [
                "run"
              ]
            },
            "type": "object"
          }
        },
        "required": [
          "data"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "requestable_events": false
            },
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "data": {
      "additionalProperties": true,
      "properties": {
        "evidence_recorded": {
          "$ref": "#/$defs/EvidenceRecorded"
        },
        "export": {
          "$ref": "#/$defs/ExportResult"
        },
        "requestable_events": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "run": {
          "$ref": "#/$defs/RunSummary"
        }
      },
      "type": "object"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/DiagnosticEntry"
      },
      "maxItems": 100,
      "type": "array"
    },
    "operation": {
      "enum": [
        "provider.add",
        "provider.list",
        "provider.check",
        "provider.update",
        "provider.rename",
        "provider.disable",
        "provider.restore",
        "run.create",
        "run.list",
        "run.show",
        "run.graph",
        "run.history",
        "run.evidence.add",
        "run.evidence.list",
        "run.annotate",
        "run.label",
        "run.request",
        "run.guidance",
        "run.compatibility",
        "run.terminate",
        "run.export"
      ],
      "type": "string"
    },
    "outcome": {
      "enum": [
        "completed",
        "rejected",
        "error"
      ],
      "type": "string"
    },
    "reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ReasonObject"
        }
      ]
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "trace": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "request_id",
    "trace",
    "outcome",
    "reason",
    "data",
    "diagnostics"
  ],
  "title": "StructuredCliOutcomeEnvelopeV1",
  "type": "object",
  "x-loop-engine-bound-markers": {
    "diagnostic": "diagnostic_encoded_bytes",
    "diagnostics": "diagnostics_per_result_count",
    "envelope": "structured_cli_envelope_bytes",
    "request_id": "identifier_utf8_bytes",
    "run_label": "run_label_utf8_bytes",
    "trace": "filesystem_path_utf8_bytes"
  }
}
