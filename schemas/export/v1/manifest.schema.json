{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "export_manifest_schema_version": {
      "const": 1,
      "type": "integer"
    },
    "export_schema_version": {
      "const": 1,
      "type": "integer"
    },
    "exported_at": {
      "type": "string"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "enum": [
              "journal.jsonl",
              "state.json"
            ],
            "type": "string"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "export_manifest_schema_version",
    "export_schema_version",
    "run_id",
    "exported_at",
    "files"
  ],
  "title": "ExportManifestV1",
  "type": "object"
}
