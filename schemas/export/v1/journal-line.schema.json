{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "entry_kind": {
      "type": "string"
    },
    "journal_schema_version": {
      "const": 1,
      "type": "integer"
    },
    "operation": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "completed",
        "rejected",
        "error"
      ],
      "type": "string"
    },
    "reason": {
      "type": [
        "object",
        "null"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "state_after": {
      "type": "object"
    },
    "state_before": {
      "type": "object"
    },
    "ts": {
      "type": "string"
    }
  },
  "required": [
    "journal_schema_version",
    "sequence",
    "run_id",
    "ts",
    "operation",
    "request_id",
    "entry_kind",
    "outcome",
    "reason",
    "state_before",
    "state_after"
  ],
  "title": "ExportJournalLineV1",
  "type": "object"
}
