{
  "$defs": {
    "InputDeclarationDto": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "type": [
            "object",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "required"
      ],
      "type": "object"
    },
    "ProviderRole": {
      "enum": [
        "describe",
        "validate_inputs",
        "evaluate_gates",
        "live_guidance",
        "check_compatibility"
      ],
      "type": "string"
    },
    "RegistrationDto": {
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "config_revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "executable": {
          "type": "string"
        },
        "registration_id": {
          "type": "string"
        },
        "timeout_seconds": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "working_directory": {
          "type": "string"
        }
      },
      "required": [
        "registration_id",
        "config_revision",
        "executable",
        "argv",
        "working_directory",
        "timeout_seconds"
      ],
      "type": "object"
    },
    "ValidateInputsPayloadDto": {
      "properties": {
        "candidate_values": {
          "additionalProperties": true,
          "type": "object"
        },
        "declarations": {
          "items": {
            "$ref": "#/$defs/InputDeclarationDto"
          },
          "type": "array"
        }
      },
      "required": [
        "declarations",
        "candidate_values"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/ValidateInputsPayloadDto"
    },
    "protocol_major": {
      "const": 1,
      "type": "integer"
    },
    "registration": {
      "$ref": "#/$defs/RegistrationDto"
    },
    "role": {
      "const": "validate_inputs",
      "type": "string"
    }
  },
  "required": [
    "protocol_major",
    "role",
    "invocation_id",
    "registration",
    "payload"
  ],
  "title": "RequestEnvelope",
  "type": "object",
  "x-loop-engine-bounds": {
    "diagnostic_encoded_bytes": 8192,
    "diagnostics_per_result_count": 100,
    "evidence_locator_utf8_bytes": 8192,
    "evidence_record_encoded_bytes": 65536,
    "graph_projection_canonical_bytes": 524288,
    "guidance_text_bytes": 262144,
    "identifier_utf8_bytes": 128,
    "metadata_nesting_depth": 16,
    "provider_request_json_bytes": 4194304,
    "provider_result_stdout_bytes": 1048576,
    "provider_snapshot_envelope_bytes": 524288,
    "run_inputs_encoded_total_bytes": 1048576
  }
}