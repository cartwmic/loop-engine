{
  "$defs": {
    "TraceCategory": {
      "enum": [
        "invocation",
        "driver",
        "parse",
        "provider",
        "persistence",
        "decision",
        "trace"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "category": {
      "$ref": "#/$defs/TraceCategory"
    },
    "event": {
      "maxLength": 256,
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "type": "string"
    },
    "trace_schema_version": {
      "const": 1,
      "type": "integer"
    },
    "ts": {
      "type": "string"
    }
  },
  "required": [
    "trace_schema_version",
    "ts",
    "request_id",
    "category",
    "event"
  ],
  "title": "TraceEvent",
  "type": "object",
  "x-loop-engine-bound-markers": {
    "directory": "trace_directory_budget_bytes",
    "file": "trace_file_max_bytes",
    "initial_reservation": "trace_init_reservation_bytes",
    "provider_call_reservation": "trace_provider_call_reservation_bytes"
  }
}
