{
  "type": "object",
  "additionalProperties": false,
  "required": ["review_contract_version", "review_stage", "author", "judgments"],
  "properties": {
    "review_contract_version": {"type": "integer", "const": 2},
    "review_stage": {
      "type": "string",
      "enum": ["individual", "aggregate"]
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["human", "agent", "script"]}
      }
    },
    "judgments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "result", "findings", "grounds"],
            "properties": {
              "axis": {"type": "string", "minLength": 1},
              "result": {"enum": ["pass", "fail"]},
              "findings": {"type": "string"},
              "grounds": {"$ref": "#/definitions/grounds"}
            },
            "oneOf": [
              {"properties": {"result": {"const": "pass"}, "findings": {"const": ""}}},
              {"properties": {"result": {"const": "fail"}, "findings": {"type": "string", "minLength": 1}}}
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "reuse"],
            "properties": {
              "axis": {"type": "string", "minLength": 1},
              "reuse": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "grounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "evidence"],
      "properties": {
        "reason": {"type": "string", "minLength": 1, "maxLength": 1200},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locator", "sha256"],
            "properties": {
              "locator": {"type": "string", "minLength": 1, "maxLength": 1024},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
