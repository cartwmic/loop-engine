{
  "type": "object",
  "additionalProperties": false,
  "required": ["review_stage", "author", "judgments"],
  "x-loop-engine-force-fresh": {
    "properties": {"judgments": {"items": {"required": ["result", "findings"]}}}
  },
  "properties": {
    "review_stage": {
      "type": "string",
      "enum": ["individual", "aggregate"]
    },
    "author": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {"name": {"type": "string", "minLength": 1}, "kind": {"type": "string", "enum": ["human", "agent", "script"]}}
    },
    "judgments": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["axis", "result", "findings"],
            "properties": {"axis": {"type": "string", "minLength": 1}, "result": {"enum": ["pass", "fail"]}, "findings": {"type": "string"}},
            "oneOf": [
              {"properties": {"result": {"const": "pass"}, "findings": {"const": ""}}},
              {"properties": {"result": {"const": "fail"}, "findings": {"minLength": 1}}}
            ]
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["axis", "reuse"],
            "properties": {"axis": {"type": "string", "minLength": 1}, "reuse": {"type": "string", "minLength": 1}}
          }
        ]
      }
    }
  }
}
