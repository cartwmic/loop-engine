#!/usr/bin/env python3
"""Fixture judge that returns a revision-binding mismatch."""

from __future__ import annotations

import json
import sys


def main() -> int:
    request = json.load(sys.stdin)
    response = {
        "schema_version": 1,
        "parent_revision": "wrong-parent",
        "candidate_revision": "wrong-candidate",
        "verdict": "pass",
        "citations": [
            {
                "rubric_id": request["rubrics"][0]["id"],
                "rule": "I47",
                "lines": ["docs/note.md:1"],
            }
        ],
        "message": "fixture revision mismatch",
    }
    json.dump(response, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
