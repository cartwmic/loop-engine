#!/usr/bin/env python3
"""Fixture judge that emits a schema-valid but request-unbound citation."""

from __future__ import annotations

import json
import sys


def main() -> int:
    request = json.load(sys.stdin)
    response = {
        "schema_version": 1,
        "parent_revision": request["parent_revision"],
        "candidate_revision": request["candidate_revision"],
        "verdict": "pass",
        "citations": [
            {
                "rubric_id": "invented-rubric",
                "rule": "invented-rule",
                "lines": ["docs/note.md:999999"],
            }
        ],
        "message": "must be rejected",
    }
    json.dump(response, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
