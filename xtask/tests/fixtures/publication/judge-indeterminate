#!/usr/bin/env python3
"""Fixture judge that emits indeterminate echoing request revisions."""

from __future__ import annotations

import json
import sys


def main() -> int:
    request = json.load(sys.stdin)
    response = {
        "schema_version": 1,
        "parent_revision": request["parent_revision"],
        "candidate_revision": request["candidate_revision"],
        "verdict": "indeterminate",
        "citations": [
            {
                "rubric_id": request["rubrics"][0]["id"],
                "rule": "I47",
                "lines": ["docs/intent.md:1"],
            }
        ],
        "message": "fixture indeterminate",
    }
    json.dump(response, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
