{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.local/quality/semantic-judge/v2/response.schema.json",
  "title": "Semantic judge response v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_kind", "axis_id", "base_revision", "candidate_revision", "candidate_tree", "status", "citations", "message"],
  "properties": {
    "schema_version": { "const": 2 },
    "request_kind": { "enum": ["axis", "correction", "coherence"] },
    "axis_id": { "$ref": "#/$defs/non_empty" },
    "base_revision": { "$ref": "#/$defs/non_empty" },
    "candidate_revision": { "$ref": "#/$defs/non_empty" },
    "candidate_tree": { "$ref": "#/$defs/non_empty" },
    "status": { "enum": ["pass", "block", "indeterminate", "unavailable"] },
    "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
    "message": { "$ref": "#/$defs/non_empty" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "unavailable" } }, "required": ["status"] },
      "then": { "properties": { "citations": { "maxItems": 0 } } },
      "else": { "properties": { "citations": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "non_empty": { "type": "string", "minLength": 1 },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "detail"],
      "properties": {
        "kind": { "enum": ["rubric", "candidate", "deterministic_evidence", "axis_result"] },
        "reference": { "$ref": "#/$defs/non_empty" },
        "detail": { "$ref": "#/$defs/non_empty" }
      }
    }
  }
}
