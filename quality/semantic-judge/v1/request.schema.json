{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.local/quality/semantic-judge/v1/request.schema.json",
  "title": "Semantic judge request v1",
  "description": "Generic versioned request for replaceable semantic judge executables. Frozen by T012; formalized by T023.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "parent_revision",
    "candidate_revision",
    "diff",
    "rubrics",
    "deterministic_evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Request schema major version."
    },
    "mode": {
      "type": "string",
      "enum": ["local", "publication"],
      "description": "Disposition context for the caller; judges remain generic."
    },
    "parent_revision": {
      "type": "string",
      "minLength": 1,
      "description": "Parent git object name."
    },
    "candidate_revision": {
      "type": "string",
      "minLength": 1,
      "description": "Candidate git object name."
    },
    "diff": {
      "type": "string",
      "description": "Exact parent-to-candidate diff text, except the pinned one-time foundation migration uses the exact reviewed-C1-to-candidate governance-repair delta plus complete-range digest evidence."
    },
    "relevant_docs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relevant_doc"
      },
      "description": "Optional resulting documentation snapshots."
    },
    "rubrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rubric"
      },
      "description": "Non-empty parent rubric payloads; callers must not substitute candidate rubrics."
    },
    "deterministic_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deterministic_evidence_item"
      },
      "description": "Deterministic build/test/check command transcripts supplied by the caller."
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional per-request timeout override in seconds."
    }
  },
  "$defs": {
    "relevant_doc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deterministic_evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "stdout", "stderr"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "candidate_revision": {
          "type": "string",
          "minLength": 1,
          "description": "Optional exact candidate binding for command evidence produced by revision-aware quality runners."
        }
      }
    }
  }
}
