PY

echo "== hermetic foundation-seed fallback ignores candidate frozen file =="
python3 - <<'PY' "$ROOT"
import hashlib
import json
import subprocess
import sys
from pathlib import Path

root = Path(sys.argv[1])
repo = root.parents[2]
frozen = root / "frozen" / "foundation-seed.v1.md"
pinned = "3f1bd3489401ca6114ac1ef756ad4e87798a2d1ed3973c16625fd87167c1b3cd"
original = frozen.read_text(encoding="utf-8") if frozen.is_file() else ""
try:
    frozen.write_text("candidate-controlled tampered digest=deadbeef\n", encoding="utf-8")
    smoke = json.loads(
        subprocess.check_output(
            ["python3", str(root / "request_builder.py"), "--publication-smoke"],
            cwd=repo,
            text=True,
        )
    )
    rubric = smoke["rubrics"][0]
    digest = hashlib.sha256(rubric["content"].encode("utf-8")).hexdigest()
    assert digest == pinned, digest
    assert "candidate-controlled" not in rubric["content"]
    assert "deadbeef" not in rubric["content"]
    provenance = [
        item
        for item in smoke["deterministic_evidence"]
        if item["command"].startswith("git show 7552af5968b4a2c10aefd01fbfa6c351817e1b8b:")
    ]
    assert len(provenance) == 4, provenance
finally:
    if original:
        frozen.write_text(original, encoding="utf-8")
print("OK foundation-seed fallback derives from foundation Git blobs")
PY

