echo "== revision binding: config failure echoes parsed revisions =="
python3 - <<'PY' "$ROOT"
import io
import json
import sys
from contextlib import redirect_stdout
from pathlib import Path

root = Path(sys.argv[1])
sys.path.insert(0, str(root))
import adapter

request = json.loads((root / "examples" / "request.v1.json").read_text(encoding="utf-8"))
binding = adapter.RevisionBinding.from_request(request)
assert binding.is_complete, binding

orig_config = adapter.CONFIG_PATH
adapter.CONFIG_PATH = root / "nonexistent-config-for-contract-test.json"
stdout = io.StringIO()
try:
    with redirect_stdout(stdout):
        adapter.load_config(binding)
except SystemExit:
    pass
finally:
    adapter.CONFIG_PATH = orig_config

payload = json.loads(stdout.getvalue())
assert payload["verdict"] == "unavailable", payload
assert payload["parent_revision"] == request["parent_revision"], payload
assert payload["candidate_revision"] == request["candidate_revision"], payload
print("OK config failure echoes parsed revision binding")
PY

echo "== revision binding: matching response accepted =="
python3 - <<'PY' "$ROOT"
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

root = Path(sys.argv[1])
request = json.loads((root / "examples" / "request.v1.json").read_text(encoding="utf-8"))
parent = request["parent_revision"]
candidate = request["candidate_revision"]

with tempfile.TemporaryDirectory() as tmp_dir:
    tmp = Path(tmp_dir)
    stub = tmp / "pi-stub"
    stub.write_text(
        f'''#!/usr/bin/env python3
import json
print(json.dumps({{
    "schema_version": 1,
    "parent_revision": "{parent}",
    "candidate_revision": "{candidate}",
    "verdict": "pass",
    "citations": [{{"rubric_id": "foundation-seed", "rule": "I47", "lines": ["docs/change/initial-implementation/README.md:1"]}}],
    "message": "binding ok",
}}))
''',
        encoding="utf-8",
    )
    stub.chmod(0o755)
    env = os.environ.copy()
    env["LOOP_ENGINE_SEMANTIC_JUDGE_PI"] = str(stub)
    completed = subprocess.run(
        [str(root / "judge")],
        input=json.dumps(request),
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )

payload = json.loads(completed.stdout)
assert payload["verdict"] == "pass", payload
assert payload["parent_revision"] == parent, payload
assert payload["candidate_revision"] == candidate, payload
print("OK matching revision binding accepted")
PY

