echo "== adapter stdin protocol (no prompt argv) =="
python3 - <<'PY' "$ROOT"
import json
import os
import sys
import tempfile
from pathlib import Path

root = Path(sys.argv[1])
sys.path.insert(0, str(root))
from adapter import RevisionBinding, invoke_pi

marker = "SEMANTIC_JUDGE_STDIN_PROTOCOL_" + ("x" * 200_000)
config = json.loads((root / "config.json").read_text(encoding="utf-8"))

with tempfile.TemporaryDirectory() as tmp_dir:
    tmp = Path(tmp_dir)
    argv_path = tmp / "argv.json"
    stdin_path = tmp / "stdin.txt"
    stub = tmp / "pi-stub"
    stub.write_text(
        """#!/usr/bin/env python3
import json
import os
import sys

with open(os.environ["STUB_ARGV_PATH"], "w", encoding="utf-8") as fh:
    json.dump(sys.argv, fh)
with open(os.environ["STUB_STDIN_PATH"], "w", encoding="utf-8") as fh:
    fh.write(sys.stdin.read())
print('{"schema_version":1,"verdict":"pass","citations":[{"rubric_id":"foundation-seed","rule":"I47","lines":["docs/change/initial-implementation/README.md:1"]}],"message":"stub ok"}')
""",
        encoding="utf-8",
    )
    stub.chmod(0o755)

    env = os.environ.copy()
    env["LOOP_ENGINE_SEMANTIC_JUDGE_PI"] = str(stub)
    env["STUB_ARGV_PATH"] = str(argv_path)
    env["STUB_STDIN_PATH"] = str(stdin_path)
    old_env = {key: os.environ.get(key) for key in env}
    os.environ.update(env)
    try:
        text = invoke_pi(
            marker,
            config,
            timeout_seconds=30,
            binding=RevisionBinding(
                parent_revision="7552af5968b4a2c10aefd01fbfa6c351817e1b8b",
                candidate_revision="581c23bb085718d37d994d77d59d3d70b7ea309f",
            ),
        )
    finally:
        for key, value in old_env.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value

    argv = json.loads(argv_path.read_text(encoding="utf-8"))
    stdin_data = stdin_path.read_text(encoding="utf-8")

assert stdin_data == marker, "prompt must be delivered on subprocess stdin"
assert marker not in argv, "prompt must not appear as an argv element"
assert "--print" in argv
assert "--no-session" in argv
assert "--no-tools" in argv
assert "-p" not in argv, "adapter must not pass -p when using stdin transport"
assert "pass" in text
print("OK adapter passes prompt via stdin not argv")
PY

