#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"

echo "== fixture matrix =="
"$ROOT/judge" --validate-fixtures

echo "== strict response validation =="
python3 - <<'PY' "$ROOT"
import sys
from pathlib import Path

root = Path(sys.argv[1])
sys.path.insert(0, str(root))
import adapter

base = {
    "schema_version": 1,
    "parent_revision": "parent",
    "candidate_revision": "candidate",
    "verdict": "pass",
    "citations": [{
        "rubric_id": "documentation",
        "rule": "coherence",
        "lines": ["docs/development-policy.md:1"],
    }],
    "message": "coherent",
}
assert adapter.validate_response(base) is None

invalid = []
for key, value in [
    ("schema_version", 2),
    ("message", ""),
    ("citations", []),
]:
    payload = dict(base)
    payload[key] = value
    invalid.append(payload)
payload = dict(base)
payload["extra"] = True
invalid.append(payload)
payload = dict(base)
payload["citations"] = [{
    "rubric_id": "",
    "rule": "",
    "lines": [None],
    "extra": True,
}]
invalid.append(payload)
for payload in invalid:
    assert adapter.validate_response(payload) is not None, payload
assert adapter.extract_json_object('prose before {"verdict":"pass"}') is None
request = {
    "rubrics": [{"id": "foundation-seed", "content": "# I47\n\nRule."}],
    "relevant_docs": [{"path": "docs/testing.md", "content": "result"}],
    "diff": "diff --git a/docs/testing.md b/docs/testing.md\n",
}
bound = dict(base)
bound["citations"] = [{
    "rubric_id": "foundation-seed",
    "rule": "I47",
    "lines": ["docs/testing.md:1"],
}]
assert adapter.validate_response_against_request(bound, request) is None
bound["citations"][0]["lines"] = ["docs/testing.md"]
assert adapter.validate_response_against_request(bound, request) is None
bound["citations"][0]["rule"] = "v1"
assert adapter.validate_response_against_request(bound, request) is not None
bound["citations"][0]["rule"] = "I47"
bound["citations"][0]["lines"] = ["docs/testing.md:999999"]
assert adapter.validate_response_against_request(bound, request) is not None
bound["citations"][0]["rubric_id"] = "invented"
assert adapter.validate_response_against_request(bound, request) is not None
print("OK malformed, prose-wrapped, uncited, and unbound responses are rejected")
PY

echo "== config json =="
python3 -m json.tool "$ROOT/config.json" >/dev/null
python3 -m json.tool "$ROOT/../../rubrics/manifest.json" >/dev/null

echo "== example json =="
python3 -m json.tool "$ROOT/examples/request.v1.json" >/dev/null
python3 -m json.tool "$ROOT/examples/response-pass.v1.json" >/dev/null

echo "== request builder protocol =="
python3 "$ROOT/request_builder.py" --verify-protocol

python3 - <<'PY' "$ROOT"
import json
import subprocess
import sys
from pathlib import Path

root = Path(sys.argv[1])
repo = root.parents[2]
smoke = json.loads(
    subprocess.check_output(
        ["python3", str(root / "request_builder.py"), "--publication-smoke"],
        cwd=repo,
        text=True,
    )
)
rubric = smoke["rubrics"][0]
assert rubric["id"] == "foundation-seed", rubric
assert "candidate-tree" not in rubric["content"], "publication smoke must not read candidate working-tree rubric"
assert smoke["parent_revision"] == "7552af5968b4a2c10aefd01fbfa6c351817e1b8b"
assert smoke["candidate_revision"] == "581c23bb085718d37d994d77d59d3d70b7ea309f"
