{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.local/quality/semantic-judge/v1/response.schema.json",
  "title": "Semantic judge response v1",
  "description": "Self-binding judge result with revision echo, citations, and deterministic-evidence-backed rationale. Frozen by T012; formalized by T023.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parent_revision",
    "candidate_revision",
    "verdict",
    "citations",
    "message"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Response schema major version."
    },
    "parent_revision": {
      "description": "Echoes request parent_revision when both revisions bind; otherwise null.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "candidate_revision": {
      "description": "Echoes request candidate_revision when both revisions bind; otherwise null.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "indeterminate", "unavailable"]
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      },
      "description": "Parent-rubric citations. Empty only for unavailable."
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable rationale."
    }
  },
  "allOf": [
    {
      "description": "Revision fields bind atomically: both null or both non-empty strings.",
      "oneOf": [
        {
          "properties": {
            "parent_revision": { "type": "null" },
            "candidate_revision": { "type": "null" }
          },
          "required": ["parent_revision", "candidate_revision"]
        },
        {
          "properties": {
            "parent_revision": { "type": "string", "minLength": 1 },
            "candidate_revision": { "type": "string", "minLength": 1 }
          },
          "required": ["parent_revision", "candidate_revision"]
        }
      ]
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "unavailable" }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "citations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "enum": ["pass", "fail", "indeterminate"] }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "parent_revision": { "type": "string", "minLength": 1 },
          "candidate_revision": { "type": "string", "minLength": 1 },
          "citations": {
            "minItems": 1
          }
        },
        "required": ["parent_revision", "candidate_revision"]
      }
    }
  ],
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_id", "rule", "lines"],
      "properties": {
        "rubric_id": {
          "type": "string",
          "minLength": 1,
          "description": "Parent rubric identifier cited by the judge."
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "description": "Rubric rule identifier or heading cited by the judge."
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Repository path with optional :line suffix, for example docs/testing.md:220."
          }
        }
      }
    }
  }
}
