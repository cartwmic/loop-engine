{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.local/schemas/quality/evidence/v1/acceptance-report.schema.json",
  "title": "Loop Engine final acceptance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_revision",
    "status",
    "reference_behaviors",
    "invariants",
    "facets"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_revision": { "type": "string", "minLength": 1 },
    "status": { "const": "passed" },
    "reference_behaviors": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": { "$ref": "#/$defs/evidence_row" }
    },
    "invariants": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "items": { "$ref": "#/$defs/evidence_row" }
    },
    "facets": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": { "$ref": "#/$defs/facet_row" }
    }
  },
  "$defs": {
    "evidence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "status", "evidence"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "status": { "const": "closed" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "facet_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operation_id", "status", "evidence"],
      "properties": {
        "key": { "type": "string", "pattern": "^facet:" },
        "operation_id": { "type": "string", "minLength": 1 },
        "status": { "const": "closed" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
