{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_revision", "candidate_revision", "candidate_tree", "manifest_digest", "rubric_digests", "semantic_topology", "deterministic_results", "axis_results", "coherence_result", "derived_disposition"],
  "properties": {
    "schema_version": { "const": 1 },
    "base_revision": { "$ref": "definitions.schema.json#/$defs/objectId" },
    "candidate_revision": { "$ref": "definitions.schema.json#/$defs/objectId" },
    "candidate_tree": { "$ref": "definitions.schema.json#/$defs/objectId" },
    "manifest_digest": { "$ref": "definitions.schema.json#/$defs/digest" },
    "rubric_digests": { "$ref": "definitions.schema.json#/$defs/rubricDigests" },
    "semantic_topology": { "$ref": "definitions.schema.json#/$defs/semanticTopology" },
    "deterministic_results": { "$ref": "definitions.schema.json#/$defs/deterministicResult" },
    "axis_results": { "type": "array", "items": { "$ref": "definitions.schema.json#/$defs/normalizedResult" } },
    "coherence_result": { "anyOf": [{ "$ref": "definitions.schema.json#/$defs/normalizedResult" }, { "type": "null" }] },
    "derived_disposition": { "enum": ["pass", "deterministic_block", "semantic_block"] }
  },
  "allOf": [
    {
      "if": { "properties": { "derived_disposition": { "const": "deterministic_block" } }, "required": ["derived_disposition"] },
      "then": { "properties": { "axis_results": { "maxItems": 0 }, "coherence_result": { "type": "null" } } },
      "else": { "properties": { "axis_results": { "minItems": 4, "maxItems": 4 }, "coherence_result": { "$ref": "definitions.schema.json#/$defs/normalizedResult" } } }
    }
  ]
}
