{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "definitions.schema.json",
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "objectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "rubricDigests": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "semanticBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rubric"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rubric": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
      }
    },
    "semanticTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axes", "coherence"],
      "properties": {
        "axes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/semanticBinding" } },
        "coherence": { "$ref": "#/$defs/semanticBinding" }
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_revision", "candidate_revision", "candidate_tree"],
      "properties": {
        "base_revision": { "$ref": "#/$defs/objectId" },
        "candidate_revision": { "$ref": "#/$defs/objectId" },
        "candidate_tree": { "$ref": "#/$defs/objectId" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set", "unset"],
      "properties": {
        "set": { "type": "object", "additionalProperties": { "type": "string" } },
        "unset": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "valueExpansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "expanded", "error"],
      "properties": {
        "declared": { "type": "string" },
        "expanded": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "environmentExpansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set", "unset"],
      "properties": {
        "set": { "type": "object", "additionalProperties": { "$ref": "#/$defs/valueExpansion" } },
        "unset": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "data", "complete"],
      "properties": {
        "encoding": { "enum": ["utf-8", "base64"] },
        "data": { "type": "string" },
        "complete": { "type": "boolean" }
      }
    },
    "termination": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "code"], "properties": { "kind": { "const": "exit" }, "code": { "type": "integer" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "signal"], "properties": { "kind": { "const": "signal" }, "signal": { "type": "integer" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["timeout", "cancelled"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "streams"], "properties": { "kind": { "const": "output_limit" }, "streams": { "type": "array", "items": { "enum": ["stdout", "stderr"] }, "uniqueItems": true } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "failure_kind", "message"], "properties": { "kind": { "const": "spawn_failure" }, "failure_kind": { "enum": ["invalid_candidate_root", "invalid_cwd", "cwd_outside_candidate", "invalid_configuration", "executable_not_found", "spawn"] }, "message": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "message"], "properties": { "kind": { "const": "supervision_failure" }, "message": { "type": "string" } } }
      ]
    },
    "cleanup": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "not_required" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "term_sent", "kill_sent"], "properties": { "kind": { "const": "completed" }, "term_sent": { "type": "boolean" }, "kill_sent": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "term_sent", "kill_sent", "message"], "properties": { "kind": { "const": "failed" }, "term_sent": { "type": "boolean" }, "kill_sent": { "type": "boolean" }, "message": { "type": "string" } } }
      ]
    },
    "processOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["termination", "stdout", "stderr", "duration_millis", "cleanup"],
      "properties": {
        "termination": { "$ref": "#/$defs/termination" },
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" },
        "duration_millis": { "type": "integer", "minimum": 0 },
        "cleanup": { "$ref": "#/$defs/cleanup" }
      }
    },
    "commandFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": { "enum": ["configuration", "process", "stdout_mismatch", "candidate_mutation"] },
        "message": { "type": "string" }
      }
    },
    "commandRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "scope", "status", "program", "args", "cwd", "environment", "program_expansion", "args_expansion", "cwd_expansion", "environment_expansion", "timeout_seconds", "max_output_bytes", "install_hint", "process", "source_verified", "failure"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["prerequisite", "check"] },
        "scope": { "type": ["string", "null"], "enum": ["repository", "changed-files", null] },
        "status": { "enum": ["passed", "failed", "skipped_success", "blocked"] },
        "program": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "environment": { "$ref": "#/$defs/environment" },
        "program_expansion": { "$ref": "#/$defs/valueExpansion" },
        "args_expansion": { "type": "array", "items": { "$ref": "#/$defs/valueExpansion" } },
        "cwd_expansion": { "$ref": "#/$defs/valueExpansion" },
        "environment_expansion": { "$ref": "#/$defs/environmentExpansion" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "install_hint": { "type": ["string", "null"] },
        "process": { "anyOf": [{ "$ref": "#/$defs/processOutcome" }, { "type": "null" }] },
        "source_verified": { "type": ["boolean", "null"] },
        "failure": { "anyOf": [{ "$ref": "#/$defs/commandFailure" }, { "type": "null" }] }
      }
    },
    "deterministicResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "binding", "prerequisites", "checks", "final_source_verified", "final_failure"],
      "properties": {
        "phase": { "const": "publication" },
        "binding": { "$ref": "#/$defs/candidateBinding" },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/commandRecord" } },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/commandRecord" } },
        "final_source_verified": { "type": "boolean" },
        "final_failure": { "anyOf": [{ "$ref": "#/$defs/commandFailure" }, { "type": "null" }] }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "detail"],
      "properties": {
        "kind": { "enum": ["rubric", "candidate", "deterministic_evidence", "axis_result"] },
        "reference": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "semanticAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_kind", "program", "args", "cwd", "environment", "timeout_millis", "max_output_bytes", "scratch_root", "process", "contract_error"],
      "properties": {
        "request_kind": { "enum": ["axis", "correction", "coherence"] },
        "program": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "environment": { "$ref": "#/$defs/environment" },
        "timeout_millis": { "type": "integer", "minimum": 0 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "scratch_root": { "type": "string" },
        "process": { "$ref": "#/$defs/processOutcome" },
        "contract_error": { "type": ["string", "null"] }
      }
    },
    "normalizedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "citations", "message", "attempts", "source_verified"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "block", "indeterminate", "unavailable"] },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
        "message": { "type": "string" },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/semanticAttempt" } },
        "source_verified": { "type": ["boolean", "null"] }
      }
    }
  }
}
