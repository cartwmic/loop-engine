{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attempt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "update_kind", "input_kind", "input_evidence", "updates", "rejection_code", "base_revision", "candidate_revision", "candidate_tree", "manifest_digest", "rubric_digests", "fresh_deterministic_results", "evaluation_report_digest", "approval_digest", "derived_disposition", "gate_decision", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "update_kind": { "enum": ["content", "deletion_only", "rejected"] },
    "input_kind": { "enum": ["git_update_lines", "ci_push_event"] },
    "input_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "data"],
      "properties": { "encoding": { "enum": ["utf-8", "base64"] }, "data": { "type": "string" } }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_ref", "local_sha", "remote_ref", "remote_sha"],
        "properties": {
          "local_ref": { "type": "string" }, "local_sha": { "type": "string" },
          "remote_ref": { "type": "string" }, "remote_sha": { "type": "string" }
        }
      }
    },
    "rejection_code": { "type": ["string", "null"], "enum": ["malformed_update_input", "invalid_update_shape", "multiple_content_tips", "malformed_ci_event", null] },
    "base_revision": { "anyOf": [{ "$ref": "definitions.schema.json#/$defs/objectId" }, { "type": "null" }] },
    "candidate_revision": { "anyOf": [{ "$ref": "definitions.schema.json#/$defs/objectId" }, { "type": "null" }] },
    "candidate_tree": { "anyOf": [{ "$ref": "definitions.schema.json#/$defs/objectId" }, { "type": "null" }] },
    "manifest_digest": { "anyOf": [{ "$ref": "definitions.schema.json#/$defs/digest" }, { "type": "null" }] },
    "rubric_digests": { "anyOf": [{ "$ref": "definitions.schema.json#/$defs/rubricDigests" }, { "type": "null" }] },
    "fresh_deterministic_results": { "type": "array", "items": { "$ref": "definitions.schema.json#/$defs/deterministicResult" } },
    "evaluation_report_digest": { "anyOf": [{ "$ref": "definitions.schema.json#/$defs/digest" }, { "type": "null" }] },
    "approval_digest": { "anyOf": [{ "$ref": "definitions.schema.json#/$defs/digest" }, { "type": "null" }] },
    "derived_disposition": { "enum": ["pass", "deterministic_block", "semantic_block"] },
    "gate_decision": { "enum": ["pass", "approved", "block"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "update_kind": { "const": "content" } }, "required": ["update_kind"] },
      "then": {
        "properties": {
          "rejection_code": { "type": "null" },
          "base_revision": { "$ref": "definitions.schema.json#/$defs/objectId" },
          "candidate_revision": { "$ref": "definitions.schema.json#/$defs/objectId" },
          "candidate_tree": { "$ref": "definitions.schema.json#/$defs/objectId" },
          "manifest_digest": { "$ref": "definitions.schema.json#/$defs/digest" },
          "rubric_digests": { "$ref": "definitions.schema.json#/$defs/rubricDigests" },
          "fresh_deterministic_results": { "minItems": 1, "maxItems": 1 },
          "evaluation_report_digest": { "$ref": "definitions.schema.json#/$defs/digest" }
        }
      },
      "else": {
        "properties": {
          "base_revision": { "type": "null" }, "candidate_revision": { "type": "null" },
          "candidate_tree": { "type": "null" }, "manifest_digest": { "type": "null" },
          "rubric_digests": { "type": "null" }, "fresh_deterministic_results": { "maxItems": 0 },
          "evaluation_report_digest": { "type": "null" }, "approval_digest": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "update_kind": { "const": "deletion_only" } }, "required": ["update_kind"] },
      "then": { "properties": { "rejection_code": { "type": "null" }, "derived_disposition": { "const": "pass" }, "gate_decision": { "const": "pass" } } }
    },
    {
      "if": { "properties": { "update_kind": { "const": "rejected" } }, "required": ["update_kind"] },
      "then": { "properties": { "rejection_code": { "type": "string" }, "derived_disposition": { "const": "deterministic_block" }, "gate_decision": { "const": "block" } } }
    },
    {
      "if": { "properties": { "gate_decision": { "const": "approved" } }, "required": ["gate_decision"] },
      "then": { "properties": { "derived_disposition": { "const": "semantic_block" }, "approval_digest": { "$ref": "definitions.schema.json#/$defs/digest" } } },
      "else": { "properties": { "approval_digest": { "type": "null" } } }
    }
  ]
}
