{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.local/quality/validation/v2/manifest.schema.json",
  "title": "Loop Engine validation manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "defaults", "runner", "checks"],
  "properties": {
    "schema_version": { "const": 2 },
    "defaults": { "$ref": "#/$defs/defaults" },
    "runner": { "$ref": "#/$defs/runner" },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "#/$defs/prerequisite" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "semantic": { "$ref": "#/$defs/semantic" }
  },
  "$defs": {
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unset": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^=]+$"
          }
        },
        "set": {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "pattern": "^[^=]+$"
          },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_output_bytes"],
      "properties": {
        "timeout_seconds": { "$ref": "#/$defs/positiveInteger" },
        "max_output_bytes": { "$ref": "#/$defs/positiveInteger" },
        "environment": { "$ref": "#/$defs/environment" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program", "install_hint"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "program": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "stdout_equals": { "type": "string" },
        "install_hint": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phases", "scope", "program", "cwd"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["pre-commit", "publication"] }
        },
        "scope": { "enum": ["repository", "changed-files"] },
        "program": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": {
          "type": "string",
          "pattern": "^\\{candidate_root\\}(?:/(?!\\.{1,2}(?:/|$))[^/{}]+)*$"
        },
        "timeout_seconds": { "$ref": "#/$defs/positiveInteger" },
        "max_output_bytes": { "$ref": "#/$defs/positiveInteger" },
        "environment": { "$ref": "#/$defs/environment" }
      }
    },
    "semanticAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rubric"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "rubric": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "cwd", "response_schema", "axes", "coherence"],
      "properties": {
        "program": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": {
          "type": "string",
          "pattern": "^\\{candidate_root\\}(?:/(?!\\.{1,2}(?:/|$))[^/{}]+)*$"
        },
        "timeout_seconds": { "$ref": "#/$defs/positiveInteger" },
        "max_output_bytes": { "$ref": "#/$defs/positiveInteger" },
        "response_schema": { "$ref": "#/$defs/repositoryPath" },
        "environment": { "$ref": "#/$defs/environment" },
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/semanticAxis" }
        },
        "coherence": { "$ref": "#/$defs/semanticAxis" }
      }
    }
  }
}
