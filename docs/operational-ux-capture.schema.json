{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational UX capture matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "argv", "timeout_ms", "obligations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}, "prefixItems": [{"type": "string", "minLength": 1}]},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}, "default": {}},
        "inherit_environment": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "obligations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "receipt"],
      "properties": {"id": {"type": "string", "minLength": 1}, "receipt": {"type": "string", "minLength": 1}}
    },
    "index": {
      "type": "object", "required": ["matrix_identity", "cwd", "settings", "receipts"],
      "properties": {
        "matrix_identity": {"type": "string", "minLength": 1},
        "cwd": {"type": "string", "minLength": 1},
        "settings": {"type": "object"},
        "receipts": {"type": "array", "items": {"$ref": "#/$defs/selection"}}
      }
    },
    "receipt": {
      "type": "object",
      "required": ["id", "argv", "resolved_executable", "cwd", "settings", "started_at", "finished_at", "wall_seconds", "exit_code", "signal", "timed_out", "spawn_error", "stdout", "stderr", "stdout_sha256", "stderr_sha256", "repository_before", "repository_after", "cleanup"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "resolved_executable": {"type": ["string", "null"]},
        "cwd": {"type": "string", "minLength": 1},
        "settings": {"type": "object"},
        "started_at": {"type": "number"},
        "finished_at": {"type": "number"},
        "wall_seconds": {"type": "number", "minimum": 0},
        "exit_code": {"type": ["integer", "null"]},
        "signal": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "aborted": {"type": "boolean"},
        "capture_error": {"type": ["string", "null"]},
        "spawn_error": {"type": ["string", "null"]},
        "stdout": {"type": "string", "minLength": 1},
        "stderr": {"type": "string", "minLength": 1},
        "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "repository_before": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "repository_after": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "cleanup": {"enum": ["complete", "pending", "unknown"]}
      }
    }
  }
}
