{
  "$defs": {
    "DiagnosticDto": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "EvidenceDto": {
      "properties": {
        "digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "additionalProperties": true,
          "type": [
            "object",
            "null"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "locator"
      ],
      "type": "object"
    },
    "GateResultDto": {
      "oneOf": [
        {
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/EvidenceDto"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "kind": {
              "const": "verdicts",
              "type": "string"
            },
            "verdicts": {
              "items": {
                "$ref": "#/$defs/GateVerdictDto"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "verdicts"
          ],
          "type": "object"
        },
        {
          "properties": {
            "diagnostics": {
              "items": {
                "$ref": "#/$defs/DiagnosticDto"
              },
              "type": "array"
            },
            "kind": {
              "const": "incompatible",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "diagnostics"
          ],
          "type": "object"
        },
        {
          "properties": {
            "diagnostics": {
              "items": {
                "$ref": "#/$defs/DiagnosticDto"
              },
              "type": "array"
            },
            "kind": {
              "const": "evaluation_error",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "diagnostics"
          ],
          "type": "object"
        }
      ]
    },
    "GateVerdictDto": {
      "properties": {
        "gate_id": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "gate_id",
        "passed"
      ],
      "type": "object"
    },
    "ProviderRole": {
      "enum": [
        "describe",
        "validate_inputs",
        "evaluate_gates",
        "live_guidance",
        "check_compatibility"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "protocol_major": {
      "const": 1,
      "type": "integer"
    },
    "provider_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "$ref": "#/$defs/GateResultDto"
    },
    "role": {
      "const": "evaluate_gates",
      "type": "string"
    }
  },
  "required": [
    "protocol_major",
    "role",
    "invocation_id",
    "result"
  ],
  "title": "ResultEnvelope",
  "type": "object"
}