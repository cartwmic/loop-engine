{
  "$defs": {
    "EmptyPayload": {
      "type": "object"
    },
    "ProviderRole": {
      "enum": [
        "describe",
        "validate_inputs",
        "evaluate_gates",
        "live_guidance",
        "check_compatibility"
      ],
      "type": "string"
    },
    "RegistrationDto": {
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "config_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "executable": {
          "type": "string"
        },
        "registration_id": {
          "type": "string"
        },
        "timeout_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "working_directory": {
          "type": "string"
        }
      },
      "required": [
        "registration_id",
        "config_revision",
        "executable",
        "argv",
        "working_directory",
        "timeout_seconds"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/EmptyPayload"
    },
    "protocol_major": {
      "const": 1,
      "type": "integer"
    },
    "registration": {
      "$ref": "#/$defs/RegistrationDto"
    },
    "role": {
      "const": "describe",
      "type": "string"
    }
  },
  "required": [
    "protocol_major",
    "role",
    "invocation_id",
    "registration",
    "payload"
  ],
  "title": "RequestEnvelope",
  "type": "object"
}