{
  "$defs": {
    "CompatibilityFindingDto": {
      "properties": {
        "capability": {
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/DiagnosticDto"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CompatibilityStatusDto"
        }
      },
      "required": [
        "capability",
        "status",
        "diagnostics"
      ],
      "type": "object"
    },
    "CompatibilityResultDto": {
      "oneOf": [
        {
          "properties": {
            "capabilities": {
              "items": {
                "$ref": "#/$defs/CompatibilityFindingDto"
              },
              "type": "array"
            },
            "kind": {
              "const": "findings",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "capabilities"
          ],
          "type": "object"
        },
        {
          "properties": {
            "diagnostics": {
              "items": {
                "$ref": "#/$defs/DiagnosticDto"
              },
              "type": "array"
            },
            "kind": {
              "const": "evaluation_error",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "diagnostics"
          ],
          "type": "object"
        }
      ]
    },
    "CompatibilityStatusDto": {
      "enum": [
        "compatible",
        "incompatible",
        "unknown"
      ],
      "type": "string"
    },
    "DiagnosticDto": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ProviderRole": {
      "enum": [
        "describe",
        "validate_inputs",
        "evaluate_gates",
        "live_guidance",
        "check_compatibility"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "protocol_major": {
      "const": 1,
      "type": "integer"
    },
    "provider_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "$ref": "#/$defs/CompatibilityResultDto"
    },
    "role": {
      "const": "check_compatibility",
      "type": "string"
    }
  },
  "required": [
    "protocol_major",
    "role",
    "invocation_id",
    "result"
  ],
  "title": "ResultEnvelope",
  "type": "object"
}