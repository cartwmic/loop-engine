{
  "initial_state": "explore",
  "live_guidance_supported": true,
  "input_declarations": [
    {
      "id": "change_id",
      "kind": "string",
      "required": false
    },
    {
      "id": "artifact_root",
      "kind": "path",
      "required": true
    },
    {
      "id": "work_root",
      "kind": "path",
      "required": false
    }
  ],
  "states": [
    "explore",
    "design",
    "design-review",
    "plan",
    "plan-review",
    "implement",
    "implementation-review",
    "validation",
    "end"
  ],
  "transitions": [
    ["explore", "intent-ready", "design", ["intent-ready"]],
    ["design", "design-ready", "design-review", ["design-ready"]],
    ["design-review", "approved", "plan", ["design-review-approved"]],
    ["design-review", "changes-requested", "design", ["design-review-changes-requested"]],
    ["plan", "plan-ready", "plan-review", ["plan-ready"]],
    ["plan-review", "approved", "implement", ["plan-review-approved"]],
    ["plan-review", "changes-requested", "plan", ["plan-review-changes-requested"]],
    ["implement", "implementation-ready", "implementation-review", ["implementation-ready"]],
    ["implementation-review", "approved", "validation", ["implementation-review-approved"]],
    ["implementation-review", "changes-requested", "implement", ["implementation-review-changes-requested"]],
    ["validation", "passed", "end", ["validation-passed"]],
    ["validation", "failed", "implement", ["validation-failed"]]
  ]
}
