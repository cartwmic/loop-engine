#!/usr/bin/env bash
# loop-engine-hook-version: 2
# Thin adapter only. Aggregate pre-push logic lives in `xtask` (R003).
# Reads git remote-update lines from stdin; does not rewrite the user tree.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
REMOTE_NAME="${1:?git pre-push did not provide destination remote name}"
REMOTE_URL="${2:?git pre-push did not provide destination remote URL}"

# `cargo run` executes gate code from working tree. Require it to match pushed
# HEAD exactly so unstaged/staged local gate edits cannot alter publication.
GATE_PATHS=(
  .githooks .cargo
  Cargo.toml Cargo.lock rust-toolchain.toml rustfmt.toml deny.toml
  xtask quality
)
if ! git diff --quiet HEAD -- "${GATE_PATHS[@]}"; then
  echo "pre-push blocked: gate implementation differs from pushed HEAD" >&2
  exit 1
fi
UNTRACKED_GATE="$(git ls-files --others --exclude-standard -- "${GATE_PATHS[@]}")"
if [ -n "$UNTRACKED_GATE" ]; then
  echo "pre-push blocked: untracked gate implementation paths must be committed or removed" >&2
  printf '%s\n' "$UNTRACKED_GATE" >&2
  exit 1
fi

unset $(git rev-parse --local-env-vars)
# Detached candidate worktrees share compiled artifacts without sharing source state.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/target/publication-cargo}"
exec env -u RUSTUP_TOOLCHAIN cargo run --quiet --locked -p xtask -- hooks pre-push \
  --remote-name "$REMOTE_NAME" \
  --remote-url "$REMOTE_URL"
